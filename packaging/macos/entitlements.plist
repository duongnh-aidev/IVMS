<?xml version="1.0" encoding="UTF-8"?>
<!-- Hardened-runtime exceptions the bundled Python needs (used only when signing with a Developer ID). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- cffi (argon2, cryptography) creates executable trampolines -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Python extension modules are signed with the same identity, but PyInstaller loads some from Frameworks -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>
</dict>
</plist>
