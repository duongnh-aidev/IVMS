# Copy to .env (done automatically by `uv run poe setup`) and adjust locally.
# .env is git-ignored; never commit real secrets.
# Read by docker compose, honcho (poe dev), poe db-* tasks and integration tests.

# --- Backend API (backend/ivms, `uv run poe dev backend`) ---
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=true
# Encrypts camera passwords stored in the database. Use a long random value outside local dev;
# changing it makes stored passwords unreadable.
SECRET_KEY=dev-only-insecure-secret-key
# Signs JWT access tokens (at least 32 characters). Changing it signs every user out.
JWT_SECRET=dev-only-insecure-jwt-secret-change-me
# Access token lifetime in seconds; after it the user must sign in again.
# 1800 = 30 minutes. Set to 5 to test expiry by hand.
ACCESS_TOKEN_TTL_SECONDS=1800

# --- Supporting services (docker-compose.yml) ---
POSTGRES_USER=ivms
POSTGRES_PASSWORD=ivms
POSTGRES_DB=ivms
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Connection URLs (keep in sync with the values above) ---
# Used by the backend and by Prisma migrations (db/prisma/schema.prisma).
DATABASE_URL=postgresql://ivms:ivms@localhost:5432/ivms
REDIS_URL=redis://localhost:6379/0

# --- Stream relay (MediaMTX, docker/mediamtx/mediamtx.yml) ---
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_HLS_PORT=8888
MEDIAMTX_WEBRTC_PORT=8889
MEDIAMTX_API_PORT=9997
MEDIAMTX_METRICS_PORT=9998
# Backend -> MediaMTX Control API, and the RTSP base that stream readers (e.g. an AI service) pull from
MEDIAMTX_API_URL=http://localhost:9997
MEDIAMTX_RTSP_URL=rtsp://localhost:8554
