# IVMS Docker install settings. install.sh copies this to .env and fills the secrets.

# Image to run: <registry>/<owner>/ivms:<version>
IVMS_IMAGE=ghcr.io/duongnh-aidev/ivms:latest
# Web UI and API: http://<this machine>:IVMS_PORT
IVMS_PORT=8080

# Generated by install.sh. Keep them: changing SECRET_KEY makes stored camera passwords unreadable,
# changing JWT_SECRET signs everyone out, and POSTGRES_PASSWORD is fixed once the database exists.
POSTGRES_PASSWORD=
SECRET_KEY=
JWT_SECRET=

# Sign-in lifetime in seconds (1800 = 30 minutes)
ACCESS_TOKEN_TTL_SECONDS=1800

MEDIAMTX_VERSION=1.21.1
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_HLS_PORT=8888
MEDIAMTX_WEBRTC_PORT=8889
MEDIAMTX_WEBRTC_UDP_PORT=8189
